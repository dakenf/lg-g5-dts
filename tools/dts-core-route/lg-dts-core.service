[Unit]
Description=Scoped LG G5 DTS core and DTS-HD/X eARC support
# Supervisor checks readiness; no ordering edge to the service it resets.
ConditionPathExists=/var/lib/lg-dts-core/enabled

[Service]
Type=simple
ExecStartPre=/usr/bin/python3 /var/lib/lg-dts-core/config-override.py ensure
ExecStart=/bin/sh /var/lib/lg-dts-core/watch.sh
ExecStopPost=/usr/bin/python3 /var/lib/lg-dts-core/config-override.py restore
TimeoutStartSec=150
KillMode=mixed
TimeoutStopSec=60
Restart=no
StandardOutput=journal
StandardError=journal
